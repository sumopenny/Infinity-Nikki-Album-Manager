{
  "name": "infinity-nikki-album-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:wasm": "node scripts/build-wasm.mjs",
    "resources:update": "node scripts/generate-nuan5-resource-catalog.mjs",
    "resources:update:poses": "node scripts/update-nikkigallery-poses.mjs",
    "build": "npm run build:wasm && vue-tsc --noEmit && vite build",
    "build:cloudflare": "npm run resources:update:poses && npm run build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "dev:remote": "vite --host 0.0.0.0 --mode remote",
    "dev:pages": "npm run build && npx wrangler@latest pages dev ./dist",
    "d1:migrate:local": "npx wrangler@latest d1 migrations apply wxnn-likes --local",
    "d1:migrate:remote": "npx wrangler@latest d1 migrations apply wxnn-likes --remote"
  },
  "dependencies": {
    "@assemblyscript/loader": "0.28.20",
    "fflate": "^0.8.3",
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "assemblyscript": "0.28.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
